 COMMAND = /usr/bin/xsltproc --timing --nonet --xinclude --stringparam 'l10n.gentext.default.language$ ' pt_BR --stringparam gimp.help.languageselector 0 --output /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/pt_BR/ /mnt/c/kilo_build/manualGIMP3.2/build/meson/stylesheets/plainhtml.xsl html/pt_BR/gimp-xrefs.xml.p/gimp.xml
 description = Generating$ html/html-pt_BR$ with$ a$ custom$ command

build html/pt_BR/gimp-help.xml: CUSTOM_COMMAND html/pt_BR/gimp-xrefs.xml stylesheets/makeindex.xsl | /usr/bin/xsltproc
 COMMAND = /usr/bin/xsltproc --timing --nonet --output /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/pt_BR/gimp-help.xml /mnt/c/kilo_build/manualGIMP3.2/build/meson/stylesheets/makeindex.xsl /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/pt_BR/gimp-xrefs.xml
 description = Generating$ html/html-pt_BR-gimp-help-xml$ with$ a$ custom$ command

build html/pt_BR/index.html: CUSTOM_COMMAND  | /usr/bin/cp html/pt_BR/gimp-xrefs.xml
 COMMAND = /usr/bin/cp -r -u /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/pt_BR/gimp-xrefs.xml.p/images /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/pt_BR/images
 description = Generating$ html/html-pt_BR-images$ with$ a$ custom$ command

build html/pt_BR-lint.log: CUSTOM_COMMAND html/pt_BR/gimp-xrefs.xml.p/gimp.xml | /usr/bin/xmllint html/pt_BR/gimp-xrefs.xml
 COMMAND = /usr/local/bin/meson --internal exe --capture html/pt_BR-lint.log -- /usr/bin/xmllint --nonet --noent --xinclude html/pt_BR/gimp-xrefs.xml.p/gimp.xml
 description = Generating$ html/validate-concat-pt_BR$ with$ a$ custom$ command$ (wrapped$ by$ meson$ to$ capture$ output)

build html/pt_BR-lint2.log: CUSTOM_COMMAND html/pt_BR-lint.log | /usr/bin/sed
 COMMAND = /usr/local/bin/meson --internal exe --capture html/pt_BR-lint2.log -- /usr/bin/sed 's,xmlns:xi="http://www.w3.org/2001/XInclude",,' html/pt_BR-lint.log
 description = Generating$ html/validate-sed-pt_BR$ with$ a$ custom$ command$ (wrapped$ by$ meson$ to$ capture$ output)

build html/pt_BR-xmllint.log: CUSTOM_COMMAND html/pt_BR-lint2.log | /usr/bin/xmllint
 COMMAND = /usr/local/bin/meson --internal exe --capture html/pt_BR-xmllint.log -- /usr/bin/xmllint --nonet --valid --output pt_BR.xml html/pt_BR-lint2.log
 description = Generating$ html/validate-xml-pt_BR$ with$ a$ custom$ command$ (wrapped$ by$ meson$ to$ capture$ output)

# Test rules

build test: phony meson-internal__test

build meson-internal__test: CUSTOM_COMMAND all meson-test-prereq PHONY
 COMMAND = /usr/local/bin/meson test --no-rebuild --print-errorlogs
 DESC = Running$ all$ tests
 pool = console

build benchmark: phony meson-internal__benchmark

build meson-internal__benchmark: CUSTOM_COMMAND all meson-benchmark-prereq PHONY
 COMMAND = /usr/local/bin/meson test --benchmark --logbase benchmarklog --num-processes=1 --no-rebuild
 DESC = Running$ benchmark$ suite
 pool = console

# Install rules

build install: phony meson-internal__install

build meson-internal__install: CUSTOM_COMMAND PHONY | all
 DESC = Installing$ files
 COMMAND = /usr/local/bin/meson install --no-rebuild
 pool = console

build dist: phony meson-internal__dist

build meson-internal__dist: CUSTOM_COMMAND PHONY
 DESC = Creating$ source$ packages
 COMMAND = /usr/local/bin/meson dist
 pool = console

# Suffix

build uninstall: phony meson-internal__uninstall

build meson-internal__uninstall: CUSTOM_COMMAND PHONY
 COMMAND = /usr/local/bin/meson --internal uninstall
 pool = console

build all: phony AUTHORS authors-copy-to-source.xml MAINTAINERS html/stylesheets/entities.xml html/xml-images-en html/en/gimp-xrefs.xml html/en/gimp-help.xml html/en/index.html html/xml-images-pt_BR html/pt_BR/gimp-xrefs.xml html/pt_BR/gimp-help.xml html/pt_BR/index.html

build meson-test-prereq: phony html/en-lint2.log html/pt_BR-lint2.log authors.xml authors-copy-to-source.xml

build meson-benchmark-prereq: phony 

build clean: phony meson-internal__clean

build clean-ctlist: phony meson-internal__clean-ctlist

build meson-internal__clean-ctlist: CUSTOM_COMMAND PHONY
 COMMAND = /usr/local/bin/meson --internal cleantrees /mnt/c/kilo_build/manualGIMP3.2/build/meson/meson-private/cleantrees.dat
 description = Cleaning$ custom$ target$ directories

build meson-internal__clean: CUSTOM_COMMAND PHONY | clean-ctlist
 COMMAND = /usr/bin/ninja -t clean
 description = Cleaning

