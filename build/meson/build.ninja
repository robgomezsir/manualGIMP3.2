html/en/gimp-help-screen.css html/stylesheets/entities.xml html/xml-images-en stylesheets/languageMenu.xsl stylesheets/plainhtml.xsl
 COMMAND = /usr/bin/xsltproc --timing --nonet --xinclude --stringparam 'l10n.gentext.default.language$ ' en --stringparam gimp.help.languageselector 0 --output /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/en/ /mnt/c/kilo_build/manualGIMP3.2/build/meson/stylesheets/plainhtml.xsl html/en/gimp-xrefs.xml.p/gimp.xml
 description = Generating$ html/html-en$ with$ a$ custom$ command

build html/en/gimp-help.xml: CUSTOM_COMMAND html/en/gimp-xrefs.xml stylesheets/makeindex.xsl | /usr/bin/xsltproc
 COMMAND = /usr/bin/xsltproc --timing --nonet --output /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/en/gimp-help.xml /mnt/c/kilo_build/manualGIMP3.2/build/meson/stylesheets/makeindex.xsl /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/en/gimp-xrefs.xml
 description = Generating$ html/html-en-gimp-help-xml$ with$ a$ custom$ command

build html/en/index.html: CUSTOM_COMMAND  | /usr/bin/cp html/en/gimp-xrefs.xml
 COMMAND = /usr/bin/cp -r -u /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/en/gimp-xrefs.xml.p/images /mnt/c/kilo_build/manualGIMP3.2/build/meson/html/en/images
 description = Generating$ html/html-en-images$ with$ a$ custom$ command

build html/en-lint.log: CUSTOM_COMMAND html/en/gimp-xrefs.xml.p/gimp.xml | /usr/bin/xmllint html/en/gimp-xrefs.xml
 COMMAND = /usr/local/bin/meson --internal exe --capture html/en-lint.log -- /usr/bin/xmllint --nonet --noent --xinclude html/en/gimp-xrefs.xml.p/gimp.xml
 description = Generating$ html/validate-concat-en$ with$ a$ custom$ command$ (wrapped$ by$ meson$ to$ capture$ output)

build html/en-lint2.log: CUSTOM_COMMAND html/en-lint.log | /usr/bin/sed
 COMMAND = /usr/local/bin/meson --internal exe --capture html/en-lint2.log -- /usr/bin/sed 's,xmlns:xi="http://www.w3.org/2001/XInclude",,' html/en-lint.log
 description = Generating$ html/validate-sed-en$ with$ a$ custom$ command$ (wrapped$ by$ meson$ to$ capture$ output)

build html/en-xmllint.log: CUSTOM_COMMAND html/en-lint2.log | /usr/bin/xmllint
 COMMAND = /usr/local/bin/meson --internal exe --capture html/en-xmllint.log -- /usr/bin/xmllint --nonet --valid --output en.xml html/en-lint2.log
 description = Generating$ html/validate-xml-en$ with$ a$ custom$ command$ (wrapped$ by$ meson$ to$ capture$ output)

