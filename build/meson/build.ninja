 description = Generating$ preface-authors-xml$ with$ a$ custom$ command

build authors-copy-to-source.xml: CUSTOM_COMMAND authors.xml | /usr/bin/cp
 COMMAND = /usr/bin/cp /mnt/c/kilo_build/manualGIMP3.2/build/meson/authors.xml /mnt/c/kilo_build/manualGIMP3.2/src/preface/authors.xml
 description = Generating$ copy-to-src-authors$ with$ a$ custom$ command

build MAINTAINERS: CUSTOM_COMMAND ../../stylesheets/doap2text.xsl ../../gimp-help.doap | /usr/bin/xsltproc
 COMMAND = /usr/bin/xsltproc -o MAINTAINERS ../../stylesheets/doap2text.xsl ../../gimp-help.doap
 description = Generating$ MAINTAINERS$ with$ a$ custom$ command

build pot/gimp.pot: CUSTOM_COMMAND ../../src/gimp.xml ../../src/help-missing.xml ../../src/introduction.xml ../../src/key-reference.xml | /mnt/c/kilo_build/manualGIMP3.2/tools/xml2pot.sh authors-copy-to-source.xml
 COMMAND = env PACKAGE=gimp-help VERSION=3.2.1 /mnt/c/kilo_build/manualGIMP3.2/tools/xml2pot.sh pot/gimp.pot . ../.. src/gimp.xml src/help-missing.xml src/introduction.xml src/key-reference.xml
