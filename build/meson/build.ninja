# This is the build file for project "gimp-help"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

# Rules for linking.

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = /usr/local/bin/meson --internal regenerate /mnt/c/kilo_build/manualGIMP3.2 .
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 

# Build rules for targets

build AUTHORS: CUSTOM_COMMAND  | /usr/bin/xsltproc stylesheets/authors.xml stylesheets/authors_text.xsl
 COMMAND = /usr/bin/xsltproc --verbose -o AUTHORS /mnt/c/kilo_build/manualGIMP3.2/build/meson/stylesheets/authors_text.xsl /mnt/c/kilo_build/manualGIMP3.2/build/meson/stylesheets/authors.xml
 description = Generating$ AUTHORS$ with$ a$ custom$ command

build authors.xml: CUSTOM_COMMAND stylesheets/authors_docbook.xsl stylesheets/authors.xml | /usr/bin/xsltproc
