            <imagedata fileref="images/menus/layer/offset-example-trans.png" format="PNG"/>
          </imageobject>
          <caption>
            <para>
              Y = -40, Edge Behavior = Make transparent
            </para>
          </caption>
        </mediaobject>
      </figure>
      <figure>
        <title>Textura repetível</title>
        <mediaobject>
          <imageobject>
            <imagedata fileref="images/menus/layer/offset-ex-heart-orig-example.png" format="PNG"/>
          </imageobject>
          <caption>
            <para>
              Original image
            </para>
          </caption>
        </mediaobject>
        <mediaobject>
          <imageobject>
            <imagedata fileref="images/menus/layer/offset-ex-heart-orig-dialog.png" format="PNG"/>
          </imageobject>
          <caption>
            <para>
              The <link linkend="gimp-layer-dialog">Layers Dialog</link> of the
              original image
            </para>
          </caption>
        </mediaobject>
        <mediaobject>
        <imageobject>
          <imagedata fileref="images/menus/layer/offset-ex-heart-repeat.png" format="PNG"/>
        </imageobject>
        <caption>
          <para>
            Edge Behavior = Wrap around, Offset = By width/2, height/2
          </para>
        </caption>
      </mediaobject>
      <mediaobject>
        <imageobject>
          <imagedata fileref="images/menus/layer/offset-ex-result.png" format="PNG"/>
        </imageobject>
        <caption>
          <para>
            Create a repeated pattern via the
            <link linkend="plug-in-tile">Tile</link> filter
          </para>
        </caption>
      </mediaobject>
    </figure>
  </sect3>
</sect2>
