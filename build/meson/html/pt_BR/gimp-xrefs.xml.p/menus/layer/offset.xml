        </imageobject>
        <caption>
          <para>
            Original image
          </para>
        </caption>
      </mediaobject>
      <mediaobject>
        <imageobject>
          <imagedata fileref="images/menus/layer/offset-example-wrap.png" format="PNG"/>
        </imageobject>
        <caption>
          <para>
            Y = -40, Edge Behavior = Wrap around
          </para>
        </caption>
      </mediaobject>
      <mediaobject>
        <imageobject>
          <imagedata fileref="images/menus/layer/offset-example-bg.png" format="PNG"/>
        </imageobject>
        <caption>
          <para>
            Y = -40, Edge Behavior = Fill with background color
          </para>
        </caption>
      </mediaobject>
      <mediaobject>
