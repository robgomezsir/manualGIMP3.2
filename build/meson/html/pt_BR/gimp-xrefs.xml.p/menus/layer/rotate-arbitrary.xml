<sect2 id="gimp-layer-rotate-arbitrary">
  <title>Rotação livre</title>

  <indexterm>
    <primary>Camada</primary>
    <secondary>Transformação</secondary>
    <tertiary>Rotação </tertiary>
  </indexterm>
  <indexterm>
    <primary>Rotacionar</primary>
  </indexterm>

  <para>
    The <guimenuitem>Arbitrary Rotation</guimenuitem> command rotates the
    selected layers by a specified angle. It is an alternate way of accessing
    the <link linkend="gimp-tool-rotate">Rotate tool</link>. See the section
    about that tool for more information.
  </para>

  <sect3>
    <title>Ativando o comando</title>
    <itemizedlist>
      <listitem>
        <para>
          You can access this command from the main menu through
          <menuchoice>
            <guimenu>Layer</guimenu>
            <guisubmenu>Transform</guisubmenu>
            <guimenuitem>Arbitrary Rotation</guimenuitem>
          </menuchoice>.
        </para>
      </listitem>
      <listitem>
        <para>
          You can also use the keyboard shortcut
          <keycombo>
            <keycap>Shift</keycap>
            <keycap>R</keycap>
          </keycombo>.
        </para>
      </listitem>
    </itemizedlist>
  </sect3>
  <sect3>
    <title>Exemplo</title>
    <figure>
      <title>Aplicando a <quote>Rotação livre</quote></title>
      <mediaobject>
        <imageobject>
          <imagedata fileref="images/menus/layer/rotate.png" format="PNG"/>
        </imageobject>
        <caption>
          <para>Antes de aplicar o comando</para>
        </caption>
      </mediaobject>
      <mediaobject>
        <imageobject>
          <imagedata fileref="images/menus/layer/rotate-arb.png" format="PNG"/>
        </imageobject>
        <caption>
          <para>A camada após ela ser girada  30° no sentido horário</para>
        </caption>
      </mediaobject>
    </figure>
  </sect3>

</sect2>
