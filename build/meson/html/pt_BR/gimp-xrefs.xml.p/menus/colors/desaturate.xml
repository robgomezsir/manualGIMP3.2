<sect2 id="gimp-colors-desaturate-menu">
  <title>O Submenu <quote>Dessaturar</quote></title>

  <indexterm>
    <primary>Cores</primary>
    <secondary>Dessaturar</secondary>
  </indexterm>

  <para>O submenu <guimenuitem>Dessaturar</guimenuitem> contém operações que tornam uma imagem em uma representação em Tons de Cinza, usando diferentes métodos.</para>

  <para>
    <itemizedlist>
      <listitem>
        <para>
          <xref linkend="gimp-filter-c2g"/>
        </para>
      </listitem>
      <listitem>
        <para>
          <xref linkend="gimp-filter-desaturate"/>
        </para>
      </listitem>
      <listitem>
        <para>
          <xref linkend="gimp-filter-mono-mixer"/>
        </para>
      </listitem>
      <listitem>
        <para>
          <xref linkend="gimp-filter-sepia"/>
        </para>
      </listitem>
    </itemizedlist>
  </para>

  <sect3>
    <title>Ativando o submenu</title>
    <para>
      You can access this submenu from the main menu through
      <menuchoice>
        <guimenu>Colors</guimenu>
        <guimenuitem>Desaturate</guimenuitem>
      </menuchoice>.
    </para>
  </sect3>
</sect2>
