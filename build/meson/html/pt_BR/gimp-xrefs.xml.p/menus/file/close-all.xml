<sect2 id="gimp-file-close-all">
  <title>Close All</title>
  <para>Este comando fecha todas as imagens que você abriu.</para>

  <sect3>
    <title>Ativando o comando</title>
    <itemizedlist>
      <listitem>
        <para>
          You can access this command from the main menu through
          <menuchoice>
            <guimenu>File</guimenu>
            <guimenuitem>Close All</guimenuitem>
          </menuchoice>.
        </para>
      </listitem>
      <listitem>
        <para>
          You can also use the keyboard shortcut
          <keycombo>
            <keycap>Shift</keycap>
            <keycap>Ctrl</keycap>
            <keycap>W</keycap>
          </keycombo>.
        </para>
      </listitem>
    </itemizedlist>
  </sect3>
</sect2>
