<sect2 id="gimp-image-guides">
  <title><quote>Guides</quote> Submenu</title>

  <indexterm>
    <primary>Guias</primary>
  </indexterm>
  <indexterm>
    <primary>Imagem</primary>
    <secondary>Guias</secondary>
  </indexterm>

  <para>O submenu de <guimenuitem>Guias</guimenuitem> contem vários comandos para a criação ou remoção de guias.</para>

  <sect3>
    <title>Ativando o submenu</title>
    <para>
      You can access this submenu from the main menu through
      <menuchoice>
        <guimenu>Image</guimenu>
        <guimenuitem>Guides</guimenuitem>
      </menuchoice>.
    </para>
  </sect3>

  <sect3>
    <title>O conteúdo do submenu <quote>Guias</quote></title>
    <para>O o submenu <guilabel>Guias</guilabel> contém os seguintes comandos:</para>
    <itemizedlist>
      <listitem>
        <para>
          <xref linkend="script-fu-guide-new-percent"/>
        </para>
      </listitem>
      <listitem>
        <para>
          <xref linkend="script-fu-guide-new"/>
        </para>
      </listitem>
      <listitem>
        <para>
          <xref linkend="script-fu-guides-from-selection"/>
        </para>
      </listitem>
      <listitem>
        <para>
          <xref linkend="script-fu-guides-remove"/>
        </para>
      </listitem>
    </itemizedlist>
  </sect3>
</sect2>
