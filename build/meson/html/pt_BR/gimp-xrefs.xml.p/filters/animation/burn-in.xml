<sect2 id="script-fu-burn-in-anim">
  <title>Queimar</title>

  <indexterm>
    <primary>Filtros</primary>
    <secondary>Animação</secondary>
    <tertiary>Queimar</tertiary>
  </indexterm>
  <indexterm><primary>Queimar</primary></indexterm>

  <sect3>
    <title>Visão Geral</title>

    <figure>
      <title>Exemplo para o filtro <quote>Queimar</quote>: imagem original</title>
      <mediaobject>
        <imageobject>
          <imagedata format="PNG" fileref="images/filters/examples/animation/burn-in-orig.png"/>
        </imageobject>
        <caption>
          <para>Camada com fundo opaco e camada em primeiro plano com transparência</para>
        </caption>
      </mediaobject>
    </figure>
    <figure>
      <title>Exemplo para o filtro <quote>Queimar</quote>: filtro aplicado</title>
      <mediaobject>
        <imageobject>
          <imagedata format="PNG" fileref="images/filters/examples/animation/burn-in-applied.png"/>
        </imageobject>
        <caption>
          <para>Imagem resultante com 8 quadros (a depender do tamanho e velocidade)</para>
        </caption>
      </mediaobject>
    </figure>
    <note>
      <para>
        It is available if your image holds an Alpha channel
        (see <xref linkend="gimp-layer-alpha-add"/>).
        Otherwise, it is disabled.
      </para>
    </note>
  </sect3>


  <sect3>
    <title>Activating the Filter</title>
    <para>
      This filter is found in the main menu under
      <menuchoice>
        <guimenu>Filters</guimenu>
        <guisubmenu>Animation</guisubmenu>
        <guimenuitem>Burn-In…</guimenuitem>
      </menuchoice>.
    </para>
  </sect3>

