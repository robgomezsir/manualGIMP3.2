<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DocBook XML V4.5//EN" "http://www.docbook.org/xml/4.5/docbookx.dtd">
<reference id="key-reference">
  <title>Referência de teclas e mouse</title>


  <refentry id="key-reference-file">
    <refmeta>
      <refentrytitle>Arquivo</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Arquivo</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-file-menu">File</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Arquivo</title>
      <variablelist>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + N</term>
          <listitem>
            <para>Nova imagem</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + V</term>
          <listitem>
            <para>Create image from Clipboard</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + O</term>
          <listitem>
            <para>Abrir imagem</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + <keycap function="alt">Alt</keycap> + O</term>
          <listitem>
            <para>Open image as layers</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="shift">Shift</keycap> +
            <keycap function="control">Ctrl</keycap> +
            <keycap function="alt">Alt</keycap> + O
          </term>
          <listitem>
            <para>Open image as link layer</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 1</term>
          <listitem>
            <para>Abrir imagem recente nº 1</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 2</term>
          <listitem>
            <para>Abrir imagem recente nº 2</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 3</term>
          <listitem>
            <para>Abrir imagem recente nº 3</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 4</term>
          <listitem>
            <para>Abrir imagem recente nº 4</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 5</term>
          <listitem>
            <para>Abrir imagem recente nº 5</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 6</term>
          <listitem>
            <para>Abrir imagem recente nº 6</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 7</term>
          <listitem>
            <para>Abrir imagem recente nº 7</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 8</term>
          <listitem>
            <para>Abrir imagem recente nº 8</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 9</term>
          <listitem>
            <para>Abrir imagem recente nº 9</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + 0</term>
          <listitem>
            <para>Abrir imagem recente nº 10</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + S</term>
          <listitem>
            <para>Save the XCF image</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + S</term>
          <listitem>
            <para>
              Save image with a different name
            </para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + E</term>
          <listitem>
            <para>Export image using the same name (overwrites old image)</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="shift">Shift</keycap> +
            <keycap function="control">Ctrl</keycap> + E
          </term>
          <listitem>
            <para>Export image using a new name to various file formats</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="control">Ctrl</keycap> +
            <keycap function="alt">Alt</keycap> + F</term>
          <listitem>
            <para>Show image in file manager</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + W</term>
          <listitem>
            <para>Close Window</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="shift">Shift</keycap> +
            <keycap function="control">Ctrl</keycap> + W
          </term>
          <listitem>
            <para>Close All</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + Q</term>
          <listitem>
            <para>Sair</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>

  <refentry id="key-reference-edit">
    <refmeta>
      <refentrytitle>Editar</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Editar</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-edit-menu">Edit</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Editar</title>
      <variablelist>
        <title>Desfazer/refazer</title>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + Z</term>
          <listitem>
            <para>Desfazer</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + Y</term>
          <listitem>
            <para>Refazer</para>
          </listitem>
        </varlistentry>
      </variablelist>
      <variablelist>
        <title>Área de transferência</title>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + X</term>
          <listitem>
            <para>Cut the selection from the image and place it in the clipboard.</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + C</term>
          <listitem>
            <para>Copiar seleção</para>
            <note>
              <para>
                This copies the selection to the clipboard.
              </para>
            </note>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="control">Ctrl</keycap>
            <keycap function="shift">Shift</keycap> + C
          </term>
          <listitem>
            <para>Copy visible</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + V</term>
          <listitem>
            <para>Colar da área de transferência</para>
            <note>
              <para>
                This creates a new layer that contains a copy of the clipboard's contents.
              </para>
            </note>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="control">Ctrl</keycap> +
            <keycap function="alt">Alt</keycap> + V
          </term>
          <listitem>
            <para>Paste in place</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="control">Ctrl</keycap> +
            <keycap function="shift">Shift</keycap> + V
          </term>
          <listitem>
            <para>Paste as new image</para>
          </listitem>
        </varlistentry>
      </variablelist>

      <variablelist>
        <title>Preencher</title>
        <varlistentry>
          <term>
            <keycap function="delete">Del</keycap>
          </term>
          <listitem>
            <para>Apagar seleção</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + ,</term>
          <listitem>
            <para>Fill with foreground Color</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + .</term>
          <listitem>
            <para>Fill with background Color</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + ;</term>
          <listitem>
            <para>Preencher com textura</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>

  <refentry id="key-reference-select">
    <refmeta>
      <refentrytitle>Selecionar</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Selecionar</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-select-menu">Select</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Seleções</title>
      <variablelist>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + A</term>
          <listitem>
            <para>Selecionar tudo</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + A</term>
          <listitem>
            <para>Selecionar nada</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + I</term>
          <listitem>
            <para>Inverter seleção</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + L</term>
          <listitem>
            <para>Cut and create a Floating selection</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + O</term>
          <listitem>
            <para>Activate select by color tool</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + V</term>
          <listitem>
            <para>Create a selection from the selected paths</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + Q</term>
          <listitem>
            <para>Toggle Quick Mask</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>

  <refentry id="key-reference-view">
    <refmeta>
      <refentrytitle>Visualizar</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Visualizar</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-view-menu">View</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Visualizar</title>
      <variablelist>
        <title>Janela</title>
        <varlistentry>
          <term>F10</term>
          <listitem>
            <para>Menu principal</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + F10, clique direito</term>
          <listitem>
            <para>Menu suspenso</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>F11</term>
          <listitem>
            <para>Alternar tela cheia</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>Aba</term>
          <listitem>
            <para>
              Toggle the visibility of the toolbox and dialog docks
            </para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + Q</term>
          <listitem>
            <para>Toggle quick Mask</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + T</term>
          <listitem>
            <para>Toggle selection outline visibility</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + J</term>
          <listitem>
            <para>Center image in window</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="control">Ctrl</keycap> + J
          </term>
          <listitem>
            <para>Shrink Wrap: Adjust window to image size</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="shift">Shift</keycap> +
            <keycap function="control">Ctrl</keycap> + J
          </term>
          <listitem>
            <para>Fit image in window</para>
          </listitem>
        </varlistentry>
      </variablelist>
      <note>
        <para>Menus também podem ser ativados por <keycap>Alt</keycap> com a letra sublinhada no nome do menu.</para>
      </note>
      <variablelist>
        <title>Zoom</title>
        <varlistentry>
          <term>+</term>
          <listitem>
            <para>Zoom de aproximação</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>-</term>
          <listitem>
            <para>Zoom de afastamento</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>1</term>
          <listitem>
            <para>Zoom 1:1</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap>+
            mouse wheel
          </term>
          <listitem>
            <para>Zoom</para>
          </listitem>
        </varlistentry>
      </variablelist>

      <variablelist>
        <title>Flip and Rotate (0°)</title>
        <varlistentry>
          <term>!</term>
          <listitem>
            <para>Reset Flip and Rotate</para>
          </listitem>
        </varlistentry>
      </variablelist>

      <variablelist>
        <title>Scrolling (panning)</title>
        <varlistentry>
          <term><keycap>Arrow keys</keycap></term>
          <listitem>
            <para>Scroll canvas</para>
            <note>
              <para>
                Combining the arrow keys with the
                <keycap function="shift">Shift</keycap> key increases the
                amount of scrolling.
                Using the arrow keys with the
                <keycap function="control">Ctrl</keycap> key jumps to the
                border of the image.
              </para>
            </note>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>middle button drag</term>
          <listitem>
            <para>Scroll canvas</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>mouse wheel</term>
          <listitem>
            <para>Scroll canvas vertically</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + mouse wheel</term>
          <listitem>
            <para>Scroll canvas horizontally</para>
          </listitem>
        </varlistentry>
      </variablelist>

      <variablelist>
        <title>Regras e abas</title>
        <varlistentry>
          <term>Mouse drag</term>
          <listitem>
            <para>
              Drag off the horizontal or vertical ruler to create a new guide
              line. Drag a line onto the ruler to delete it.
            </para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + mouse drag</term>
          <listitem>
            <para>Arraste um ponto de amostragem para fora da régua</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + R</term>
          <listitem>
            <para>Toggle visibility of rulers</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + T</term>
          <listitem>
            <para>Toggle visibility of guides</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>

  <refentry id="key-reference-image">
    <refmeta>
      <refentrytitle>Image</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Image</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-image-menu">Image</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Image</title>
      <variablelist>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + D</term>
          <listitem>
            <para>Duplicate image</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + M</term>
          <listitem>
            <para>Combinar camadas visíveis</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="alt">Alt</keycap> + <keycap>Return</keycap>
          </term>
          <listitem>
            <para>Image properties</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>

  <refentry id="key-reference-layer">
    <refmeta>
      <refentrytitle>Camadas</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Camada</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-layer-menu">Layer</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Camadas</title>
      <variablelist>
        <varlistentry>
          <term>
            <keycap function="shift">Shift</keycap> +
            <keycap function="control">Ctrl</keycap> + N</term>
          <listitem>
            <para>New layer</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="shift">Shift</keycap> +
            <keycap function="control">Ctrl</keycap> + D
          </term>
          <listitem>
            <para>Duplicate layers</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap>Page&nbsp;Up</keycap>
          </term>
          <listitem>
            <para>Select the layers above</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap>Page&nbsp;Down</keycap>
          </term>
          <listitem>
            <para>Select the layers below</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>Home</term>
          <listitem>
            <para>Selecionar a primeira camada</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>End</term>
          <listitem>
            <para>Selecionar a última camada</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + M</term>
          <listitem>
            <para>Combinar camadas visíveis</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + H</term>
          <listitem>
            <para>Anchor floating layer or mask</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="shift">Shift</keycap> +
            <keycap function="control">Ctrl</keycap> + O
          </term>
          <listitem>
            <para>Transform, Offset: shift the pixels in the layer</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>

  <refentry id="key-reference-tools">
    <refmeta>
      <refentrytitle>Ferramentas</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Ferramentas</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-tools-menu">Tools</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Ferramentas</title>
      <variablelist>
        <title>Selection Tools</title>
        <varlistentry>
          <term>R</term>
          <listitem>
            <para>Rectangle Select</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>E</term>
          <listitem>
            <para>Seleção elíptica</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>F</term>
          <listitem>
            <para>Seleção livre</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>U</term>
          <listitem>
            <para>Seleção contígua</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + O</term>
          <listitem>
            <para>Seleção por cor</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>I</term>
          <listitem>
            <para>Scissors Select</para>
          </listitem>
        </varlistentry>
      </variablelist>
      <variablelist>
        <title>Paint Tools</title>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + B</term>
          <listitem>
            <para>Preenchimento</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>G</term>
          <listitem>
            <para>Gradient</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>N</term>
          <listitem>
            <para>Lápis</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>P</term>
          <listitem>
            <para>Pincel</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + E</term>
          <listitem>
            <para>Borracha</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>A</term>
          <listitem>
            <para>Aerógrafo</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>K</term>
          <listitem>
            <para>Tinta</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>Y</term>
          <listitem>
            <para>MyPaint Brush</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>C</term>
          <listitem>
            <para>Clonar</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>H</term>
          <listitem>
            <para>Heal</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + U</term>
          <listitem>
            <para>Desfocar/deixar nítido</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>S</term>
          <listitem>
            <para>Borrar</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + D</term>
          <listitem>
            <para>Sub-exposição ou super-exposição</para>
          </listitem>
        </varlistentry>
      </variablelist>
      <variablelist>
        <title>Transform Tools</title>
        <varlistentry>
          <term>Q</term>
          <listitem>
            <para>Align and Distribute</para>
          </listitem>
        </varlistentry>
        <varlistentry>
