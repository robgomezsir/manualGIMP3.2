  <refentry id="key-reference-zoom">
    <refmeta>
      <refentrytitle>Ferramenta de Zoom</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Ferramenta de Zoom</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-tool-zoom">Zoom</link> tool
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Ferramenta de Zoom</title>
      <variablelist>
        <varlistentry>
          <term>clique</term>
          <listitem>
            <para>Zoom de aproximação</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + click</term>
          <listitem>
            <para>Zoom de afastamento</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>Arrastar o mouse</term>
          <listitem>
            <para>Zoom in inside the area</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + mouse drag</term>
          <listitem>
            <para>Zoom out inside the area</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>
