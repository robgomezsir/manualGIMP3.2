  <refentry id="key-reference-filters">
    <refmeta>
      <refentrytitle>Filtros</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Filtros</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-filters-menu">Filters</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Filtros</title>
      <variablelist>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + F</term>
          <listitem>
            <para>Repeat last filter using the same settings</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + F</term>
          <listitem>
            <para>Reapresentar último filtro</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>

  <refentry id="key-reference-windows">
    <refmeta>
      <refentrytitle>Windows</refentrytitle>
    </refmeta>
    <refnamediv>
      <refname>Windows</refname>
      <refpurpose>
        Key reference for the <link linkend="gimp-windows">Windows</link> menu
      </refpurpose>
    </refnamediv>
    <refsect1>
      <title>Diálogos de encaixe</title>
      <variablelist>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + L</term>
          <listitem>
            <para>Camadas</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + B</term>
          <listitem>
            <para>Pincéis</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="shift">Shift</keycap> + <keycap function="control">Ctrl</keycap> + P</term>
          <listitem>
            <para>Texturas</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + G</term>
          <listitem>
            <para>Degradês</para>
          </listitem>
        </varlistentry>
      </variablelist>
      <note>
        <para>Esses comandos abrem uma nova janela de diálogo se ainda não estiver aberta, caso contrário, o diálogo correspondente obtém o foco.</para>
      </note>
      <variablelist>
        <title>Dentro de um diálogo</title>
        <varlistentry>
          <term>Enter</term>
          <listitem>
            <para>Define o novo valor</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>Espaço, Enter</term>
          <listitem>
            <para>Ativar o botão ou lista atual</para>
          </listitem>
        </varlistentry>
      </variablelist>
      <variablelist>
        <title>Within a multi-tab dialog</title>
        <varlistentry>
          <term>
            <keycap function="control">Ctrl</keycap> +
            <keycap function="alt">Alt</keycap> + Page&nbsp;Up
          </term>
          <listitem>
            <para>
              Switch tabs up
            </para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>
            <keycap function="control">Ctrl</keycap> +
            <keycap function="alt">Alt</keycap> + Page&nbsp;Down
          </term>
          <listitem>
            <para>Switch tabs down</para>
          </listitem>
        </varlistentry>
      </variablelist>

      <variablelist>
        <title>Dentro de um diálogo de arquivo</title>
        <varlistentry>
          <term><keycap function="alt">Alt</keycap> + Up</term>
          <listitem>
            <para>Pasta acima</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="alt">Alt</keycap> + Down</term>
          <listitem>
            <para>Pasta abaixo</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap function="alt">Alt</keycap> + Home</term>
          <listitem>
            <para>Pasta inicial</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term>Esc</term>
          <listitem>
            <para>Fechar diálogo</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>

    <refsect1>
      <title>Miscellaneous items</title>
      <variablelist>
        <varlistentry>
          <term><keycap function="control">Ctrl</keycap> + B</term>
          <listitem>
            <para>Raise the Toolbox</para>
          </listitem>
        </varlistentry>
        <varlistentry>
          <term><keycap>Tab</keycap></term>
          <listitem>
            <para>Toggle between showing and hiding Docks</para>
          </listitem>
        </varlistentry>
      </variablelist>
    </refsect1>
  </refentry>

